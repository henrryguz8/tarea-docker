# ===== MySQL =====
# Contraseña del usuario root de MySQL
MYSQL_ROOT_PASSWORD=cambia_esta_root
# Nombre de la base de datos que se crea al iniciar
MYSQL_DATABASE=tarea_db
# Usuario y contraseña que usará Laravel
MYSQL_USER=tarea_user
MYSQL_PASSWORD=cambia_esta_password

# ===== Laravel =====
APP_NAME=TareaDocker
APP_URL=http://localhost:8000
# Genera una clave con (PowerShell):
# docker run --rm php:8.4-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
# (si la dejas vacía, el contenedor genera una temporal)
# true = ejecuta php artisan migrate --force al arrancar
RUN_MIGRATIONS=true

# ===== Next.js =====
# Clave para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET=cambia_esta_clave_de_al_menos_32_caracteres

# ===== Docker Hub (opcional, para publicar imágenes) =====
DOCKERHUB_USER=henryguz8
